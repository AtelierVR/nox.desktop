{
  "type": "mod",
  "id": "nox.desktop",
  "provides": [
    "fr.hactazia.desktop",
    "desktop"
  ],
  "name": "Desktop",
  "version": "1.0.0",
  "description": "Desktop input mode: keyboard, mouse, and display management.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.desktop",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.desktop/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "controllers",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.controllers.git"
    },
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "avatars",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.avatars.git"
    },
    {
      "id": "microphone",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.microphone.git"
    },
    {
      "id": "users",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.users.git"
    },
    {
      "id": "keybinding",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.keybinding.git"
    },
    {
      "id": "session",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.sessions.git"
    },
    {
      "id": "audio",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.audio.git"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "ui"
    },
    {
      "type": "after",
      "id": "avatars"
    },
    {
      "type": "after",
      "id": "users"
    }
  ],
  "entrypoints": {
    "client": [
      "Nox.Desktop.Runtime.Client"
    ]
  }
}
